<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Loaded after the complete Light theme and controls. Popup HWNDs must not
         rely on translucent theme fills to provide their backing surface. -->
    <SolidColorBrush x:Key="FlyoutBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="#202020" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="MenuBorderColorDefaultBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="MenuBarBackground" Color="#F9F9F9" />
    <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="#EAEAEA" />
    <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="#DFDFDF" />
    <SolidColorBrush x:Key="MenuBarItemTextForegroundPressed" Color="#202020" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E3EAF3" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#202020" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#202020" />

    <Style TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
        <Setter Property="Background" Value="{DynamicResource MenuBarBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuForeground}" />
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="Background" Value="{DynamicResource ContextMenuBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuForeground}" />
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Background" Value="{DynamicResource ContextMenuBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuForeground}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuBarItemBackgroundPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ui:MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForeground}" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <!-- The package item template does not bind Background, so style-only
             selected fills do not reach the rendered item surface. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ContentBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Margin="{DynamicResource ComboBoxItemMargin}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Rectangle x:Name="ActiveRectangle" Width="3" Height="16"
                                       RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                       Fill="{DynamicResource ComboBoxItemPillFillBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource ComboBoxDropDownBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForeground}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelected}" />
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundSelected}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
