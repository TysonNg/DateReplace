<UserControl x:Class="ContractDateReplacer.App.Views.HistoryRollbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ContractDateReplacer.App.ViewModels"
             xmlns:models="clr-namespace:ContractDateReplacer.Core.Models;assembly=ContractDateReplacer.Core"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:HistoryRollbackViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Two Column Layout (Batches vs Files in Batch) -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="LỊCH SỬ THAY THẾ &amp; KHÔI PHỤC (ROLLBACK / RESTORE)" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Bảo vệ file gốc tuyệt đối 100% • Đối soát mã băm SHA256 trước và sau khi khôi phục"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="⟳ Làm Mới" Appearance="Secondary"
                               Command="{Binding LoadHistoryCommand}" Margin="0,0,10,0" />
                    <ui:Button Content="⟵ Quay Lại" Appearance="Secondary"
                               Command="{Binding NavigateBackCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Two Column Layout -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Left: Batches (35%) -->
                <ColumnDefinition Width="380" />
                <!-- Margin -->
                <ColumnDefinition Width="16" />
                <!-- Right: Files in Batch (65%) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Batches List -->
            <Border Grid.Column="0" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,8,0" />
                        <TextBlock Text="CÁC ĐỢT THAY THẾ" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Batches}"
                             SelectedItem="{Binding SelectedBatch, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BatchHistoryGroupViewModel}">
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="13" />
                                        <ui:Badge Grid.Row="0" Grid.Column="1" Content="{Binding StatusSummary}"
                                                  Appearance="{Binding StatusAppearance}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DisplaySubtitle}"
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT: Files inside selected batch -->
            <Border Grid.Column="2" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title & Batch Restore Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedBatch.DisplayTitle, FallbackValue='Chọn một đợt thay thế bên trái'}"
                                       FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="{Binding SelectedBatch.Backups.Count, StringFormat='{}Gồm {0} tệp hợp đồng đã được sao lưu an toàn', FallbackValue=''}"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Batch Restore Action -->
                        <ui:Button Grid.Column="1" Content="↺ Khôi Phục Toàn Bộ Đợt Này" Appearance="Primary" FontWeight="Bold"
                                   Command="{Binding RestoreEntireBatchCommand}" CommandParameter="{Binding SelectedBatch}"
                                   IsEnabled="{Binding SelectedBatch, Converter={x:Null}}" />
                    </Grid>

                    <!-- Files in Batch List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedBatch.Backups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BackupRecord}">
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Document Icon -->
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="20"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- File & Checksum Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="{Binding ChecksumSHA256, StringFormat='SHA256: {0}'}"
                                                           FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding FormattedDate, StringFormat='Thời điểm sao lưu: {0}'}"
                                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <ui:Badge Grid.Column="2" Content="{Binding Status}"
                                                      Appearance="{Binding StatusBadgeAppearance}"
                                                      VerticalAlignment="Center" Margin="0,0,16,0" />

                                            <!-- Restore Single File Button -->
                                            <ui:Button Grid.Column="3" Content="↺ Khôi Phục" Appearance="Secondary"
                                                       Command="{Binding DataContext.RestoreSingleFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: Bottom Action Bar -->
        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Feedback status message -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusFeedback}" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Maintenance Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="🧹 Dọn Dẹp Bản Sao Lưu Hết Hạn (> 30 ngày)" Appearance="Secondary"
                               Command="{Binding CleanupExpiredCommand}" Margin="0,0,10,0" />

                    <ui:Button Content="⟵ Quay Về Trang Chủ" Appearance="Primary"
                               Command="{Binding NavigateBackCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
