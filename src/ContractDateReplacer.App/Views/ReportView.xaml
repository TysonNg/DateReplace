<UserControl x:Class="ContractDateReplacer.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ContractDateReplacer.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReportViewModel}"
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Overview Metrics -->
            <RowDefinition Height="Auto" />
            <!-- 1: Collapsible Files Details -->
            <RowDefinition Height="*" />
            <!-- 2: Export & Navigation Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header & Summary Metrics -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="BÁO CÁO KẾT QUẢ THAY THẾ NGÀY HỢP ĐỒNG" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Tổng hợp số liệu thực thi, đối soát kiểm tra độc lập và tính toàn vẹn tài liệu"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 6 Metric Cards -->
                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,4">
                    <!-- Metric 1: Tổng số file -->
                    <Border Margin="0,0,8,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tổng số file" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalFilesProcessed}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Metric 2: Thành công hoàn toàn -->
                    <Border Margin="4,0,4,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Thành công" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SuccessFilesCount}" FontSize="22" FontWeight="Bold" Foreground="#FF107C41" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Metric 3: Cần kiểm tra lại / Lỗi -->
                    <Border Margin="4,0,4,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Cần kiểm tra" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding WarningFilesCount}" FontSize="22" FontWeight="Bold" Foreground="#FFF5A623" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Metric 4: Ngày đã thay -->
                    <Border Margin="4,0,4,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Đã thay thế" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalDatesReplaced}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Metric 5: Ngày giữ nguyên -->
                    <Border Margin="4,0,4,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Giữ nguyên" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalDatesPreserved}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Metric 6: Điểm an toàn trung bình -->
                    <Border Margin="8,0,0,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Điểm an toàn TB" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding AverageSafetyScore, StringFormat='{}{0}/100'}"
                                       FontSize="22" FontWeight="Bold" Foreground="#FF107C41" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ROW 1: Detailed File List (Collapsible / Expander) -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="16" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" Margin="0,0,8,0" />
                    <TextBlock Text="CHI TIẾT THEO FILE HỢP ĐỒNG" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FileReports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportFileDetailViewModel}">
                                <Border Margin="0,0,0,12" CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="8">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Document Icon -->
                                                <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />

                                                <!-- File Name & Safety Score -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding SafetyScore, StringFormat='(Safety Score: {0}/100)'}"
                                                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Status Badge -->
                                                <ui:Badge Grid.Column="2" Content="{Binding StatusBadgeText}"
                                                          Appearance="{Binding StatusBadgeAppearance}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            </Grid>
                                        </Expander.Header>

                                        <!-- Expanded Content: Issues & Date Items -->
                                        <StackPanel Margin="16,8,16,8">
                                            <!-- Issues List (if any) -->
                                            <ItemsControl ItemsSource="{Binding Issues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="4" Background="#26F5A623">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Warning24" Foreground="#FFF5A623" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#FFF5A623" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Dates List -->
                                            <ItemsControl ItemsSource="{Binding ReplacedItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ReportDateDetailItem}">
                                                        <Border Margin="0,3,0,3" Padding="8,6" CornerRadius="4"
                                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="• " FontWeight="Bold" Margin="0,0,4,0" />

                                                                <!-- Date info -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding OldDateText}" FontWeight="SemiBold" TextDecorations="Strikethrough"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock Text="  ➔  " FontSize="11" Margin="6,0" />
                                                                    <TextBlock Text="{Binding NewDateText}" FontWeight="Bold" Foreground="#FF107C41" />
                                                                    <TextBlock Text="{Binding ClassificationTypeName, StringFormat='  ({0})'}"
                                                                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,0,0" />
                                                                </StackPanel>

                                                                <!-- Location -->
                                                                <TextBlock Grid.Column="2" Text="{Binding SourceLocation}" FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,16,0" VerticalAlignment="Center" />

                                                                <!-- Result Badge -->
                                                                <ui:Badge Grid.Column="3" Content="{Binding ResultBadgeText}"
                                                                          Appearance="{Binding ResultBadgeAppearance}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ROW 2: Export & Navigation Action Bar -->
        <Border Grid.Row="2" Padding="20,14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Feedback message -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExportMessage}" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="← Quay lại kết quả" Appearance="Secondary"
                               Command="{Binding NavigateBackCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="📈 Xuất Excel (XLSX)" Appearance="Primary"
                               Command="{Binding ExportExcelCommand}" Margin="0,0,8,0" />

                    <ui:Button Content="📊 Xuất CSV" Appearance="Secondary"
                               Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />

                    <ui:Button Content="📋 Xuất JSON" Appearance="Secondary"
                               Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" />

                    <ui:Button Content="🖨 Báo Cáo HTML" Appearance="Secondary"
                               Command="{Binding ExportHtmlPdfCommand}" Margin="0,0,8,0" />

                    <ui:Button Content="📁 Mở Thư Mục Kết Quả" Appearance="Secondary"
                               Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0" />

                    <ui:Button Content="🔄 Làm Đợt Mới" Appearance="Secondary" FontWeight="Bold"
                               Command="{Binding ResetForNewBatchCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

