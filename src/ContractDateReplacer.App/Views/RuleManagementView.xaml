<UserControl x:Class="ContractDateReplacer.App.Views.RuleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ContractDateReplacer.App.ViewModels"
             xmlns:converters="clr-namespace:ContractDateReplacer.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:RuleManagementViewModel}"
             d:DesignHeight="800" d:DesignWidth="1150">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverterCustom x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Two Column Layout (Rules List vs Editor & Tester) -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="QUẢN LÝ QUY TẮC NHẬN DIỆN &amp; PHÂN LOẠI (RULES ENGINE)" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Tùy biến từ khóa nhận diện ngữ cảnh ngày, phân loại nhân thân, ưu tiên luật và kiểm tra trực tiếp"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="+ Thêm Quy Tắc Mới" Appearance="Primary" FontWeight="Bold"
                               Command="{Binding StartAddNewRuleCommand}" Margin="0,0,10,0" />
                    <ui:Button Content="⟵ Quay Lại" Appearance="Secondary"
                               Command="{Binding NavigateBackCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Two Column Split -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Left: Rules List (60%) -->
                <ColumnDefinition Width="3*" />
                <!-- Margin -->
                <ColumnDefinition Width="16" />
                <!-- Right: Form Editor & Rule Tester (40%) -->
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Rules List -->
            <Border Grid.Column="0" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Filter & Search Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Rules List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter & Search Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <RadioButton Content="Tất cả" IsChecked="{Binding SelectedFilter, Converter={x:Null}, Mode=OneWay}"
                                         Command="{Binding SetSelectedFilterCommand, FallbackValue={x:Null}}" Margin="0,0,6,0" />
                            <!-- Search box -->
                        </StackPanel>

                        <ui:TextBox Grid.Column="1" PlaceholderText="Tìm theo tên luật, từ khóa..."
                                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" Margin="10,0,0,0" />
                    </Grid>

                    <!-- Rules List ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredRulesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Rule Info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                                    <ui:Badge Content="{Binding TypeDisplayName}" Appearance="{Binding BadgeAppearance}" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding Priority, StringFormat='Ưu tiên: {0}'}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding KeywordsDisplayText, StringFormat='Từ khóa: {0}'}"
                                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Toggle Switch -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" Content="Bật" />
                                            </StackPanel>

                                            <!-- Action Buttons (Edit / Delete) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Custom Rules: Allow Edit & Delete -->
                                                <ui:Button Content="Sửa" Appearance="Secondary" FontSize="11" Padding="8,4"
                                                           Command="{Binding DataContext.StartEditRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,6,0" />

                                                <ui:Button Content="Xóa" Appearance="Danger" FontSize="11" Padding="8,4"
                                                           Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisConverter}}" />

                                                <!-- Built-in Rule: Protected Icon -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisConverter}}">
                                                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="Mặc định" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Form Editor & Rule Tester -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Form Editor -->
                    <RowDefinition Height="*" />
                    <!-- Margin -->
                    <RowDefinition Height="16" />
                    <!-- Rule Tester -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP: Form Editor Card -->
                <Border Grid.Row="0" Padding="16" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Edit24" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding EditorTitle}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Tên quy tắc -->
                            <TextBlock Text="Tên quy tắc:" FontSize="12" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding EditingRuleName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="VD: Ngày thỏa thuận thanh toán..." Margin="0,0,0,10" />

                            <!-- Loại ngày gán -->
                            <TextBlock Text="Loại ngày gán:" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding EditingTargetType, Mode=TwoWay}"
                                      Margin="0,0,0,10" />

                            <!-- Từ khóa kích hoạt -->
                            <TextBlock Text="Từ khóa kích hoạt (cách nhau bởi dấu phẩy):" FontSize="12" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding EditingKeywordsText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="VD: thanh toán đợt, chuyển khoản ngày, hạn nộp..." AcceptsReturn="True"
                                        Height="60" Margin="0,0,0,10" />

                            <!-- Mức độ ưu tiên -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mức độ ưu tiên (Priority):" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding EditingPriority}" FontWeight="Bold" />
                            </Grid>
                            <Slider Minimum="1" Maximum="100" Value="{Binding EditingPriority, Mode=TwoWay}" Margin="0,0,0,14" />

                            <!-- Kích hoạt -->
                            <CheckBox Content="Kích hoạt quy tắc này ngay khi lưu" IsChecked="{Binding EditingIsEnabled, Mode=TwoWay}" Margin="0,0,0,14" />

                            <!-- Save & Cancel Buttons -->
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="💾 Lưu Quy Tắc" Appearance="Primary" FontWeight="Bold"
                                           Command="{Binding SaveRuleCommand}" Margin="0,0,10,0" />
                                <ui:Button Content="Hủy" Appearance="Secondary"
                                           Command="{Binding CancelEditCommand}"
                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- BOTTOM: Rule Tester Card -->
                <Border Grid.Row="2" Padding="16" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="KIỂM TRA THỬ NGHIỆM LUẬT (RULE TESTER)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Nhập đoạn văn bản mẫu chứa ngày để thử nghiệm kết quả phân loại:" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />

                        <ui:TextBox Text="{Binding TestInputText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="VD: Hai bên ký ngày 02/09/2026 tại văn phòng..."
                                    AcceptsReturn="True" Height="50" Margin="0,0,0,8" />

                        <ui:Button Content="⚡ Phân Loại Thử Nghiệm" Appearance="Primary"
                                   Command="{Binding RunRuleTesterCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />

                        <!-- Test Result Box -->
                        <Border Padding="10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Badge Content="{Binding TestResultType}" Appearance="Success" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding TestResultConfidence, StringFormat='Độ tin cậy: {0}'}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding TestResultText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ROW 2: Bottom Action Bar -->
        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Feedback text -->
                <TextBlock Grid.Column="0" Text="{Binding FeedbackMessage}" FontSize="12"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="↺ Khôi Phục Luật Mặc Định (12 Rules)" Appearance="Secondary"
                               Command="{Binding ResetDefaultRulesCommand}" Margin="0,0,10,0" />

                    <ui:Button Content="⟵ Quay Về Trang Chủ" Appearance="Primary"
                               Command="{Binding NavigateBackCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
