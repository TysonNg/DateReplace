<UserControl x:Class="ContractDateReplacer.App.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ContractDateReplacer.App.ViewModels"
             xmlns:converters="clr-namespace:ContractDateReplacer.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AuditComplianceViewModel}"
             d:DesignHeight="800" d:DesignWidth="1150">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverterCustom x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Filter & Integrity Status Row -->
            <RowDefinition Height="Auto" />
            <!-- 2: Logs Table -->
            <RowDefinition Height="*" />
            <!-- 3: Bottom Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="NHẬT KÝ KIỂM TOÁN &amp; TUÂN THỦ (AUDIT LOG &amp; COMPLIANCE)" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Hệ thống lưu vết Append-Only chống can thiệp (Tamper-Proof) bằng chữ ký băm SHA256 theo chuẩn ISO/Doanh nghiệp"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="🛡 Kiểm Tra Toàn Vẹn" Appearance="Primary" FontWeight="Bold"
                               Command="{Binding VerifyIntegrityCommand}" Margin="0,0,10,0" />
                    <ui:Button Content="📥 Xuất CSV" Appearance="Secondary"
                               Command="{Binding ExportCsvCommand}" Margin="0,0,10,0" />
                    <ui:Button Content="⟵ Quay Lại" Appearance="Secondary"
                               Command="{Binding NavigateBackCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Filter & Integrity Status Row -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="14,10" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <ui:TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Tìm theo tên file, người dùng, chi tiết..."
                            Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" Margin="0,0,10,0" />

                <!-- Action Filter -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableActionFilters}"
                          SelectedItem="{Binding SelectedActionFilter, Mode=TwoWay}"
                          Width="180" Margin="0,0,10,0" />

                <!-- Severity Filter -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableSeverityFilters}"
                          SelectedItem="{Binding SelectedSeverityFilter, Mode=TwoWay}"
                          Width="130" Margin="0,0,10,0" />

                <!-- Integrity Status Badge -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasIntegrityResult, Converter={StaticResource BoolToVisConverter}}">
                    <ui:Badge Content="{Binding IntegrityStatusText}" Appearance="{Binding IntegrityBadgeAppearance}" FontSize="12" Padding="10,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: Logs Table -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="True"
                      Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <!-- Thời điểm -->
                    <DataGridTextColumn Header="Thời Điểm" Binding="{Binding TimestampText}" Width="150" />

                    <!-- Hành động -->
                    <DataGridTemplateColumn Header="Hành Động" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Badge Content="{Binding ActionTypeDisplayName}" Appearance="Info" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mức độ -->
                    <DataGridTemplateColumn Header="Mức Độ" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Badge Content="{Binding Severity}" Appearance="{Binding SeverityBadgeAppearance}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- File mục tiêu -->
                    <DataGridTextColumn Header="Tệp Mục Tiêu" Binding="{Binding TargetFileName}" Width="180" />

                    <!-- Người dùng / Máy -->
                    <DataGridTextColumn Header="Người Dùng / Máy" Binding="{Binding UserName}" Width="140" />

                    <!-- Chi tiết -->
                    <DataGridTextColumn Header="Chi Tiết Thao Tác" Binding="{Binding DetailsJson}" Width="*" />

                    <!-- Mã băm bảo vệ -->
                    <DataGridTextColumn Header="Chữ Ký Toàn Vẹn" Binding="{Binding IntegrityHashShort}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ROW 3: Bottom Action Bar -->
        <Border Grid.Row="3" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Feedback text -->
                <TextBlock Grid.Column="0" Text="{Binding FeedbackMessage}" FontSize="12"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />

                <!-- Action Button -->
                <ui:Button Grid.Column="1" Content="⟵ Quay Về Trang Chủ" Appearance="Primary"
                           Command="{Binding NavigateBackCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
